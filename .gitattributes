# Normalise line endings: LF in the repository, native in the working copy.
# Without this, a Windows checkout commits CRLF and every file shows as
# fully changed to a collaborator on macOS or Linux.
* text=auto eol=lf

# Windows-only scripts must keep CRLF to run.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary -- never touch these. Line-ending conversion CORRUPTS a PDF.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.gz binary

# Collapse generated files in diffs and exclude them from language stats.
*.min.js linguist-generated
package-lock.json linguist-generated
**/migrations/*.py linguist-generated

# ==========================================================================
# SECRETS -- never commit. If one of these ever lands in a commit, rotate
# the credential; removing the file in a later commit does NOT remove it
# from history.
# ==========================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json
secrets.yml
secrets.yaml


[Unit]
Description=ServoraBd API (gunicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=notify
NotifyAccess=main
User=servora
Group=www-data
RuntimeDirectory=servorabd
RuntimeDirectoryMode=0750
WorkingDirectory=/srv/servorabd/backend
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
ExecStart=/srv/servorabd/backend/venv/bin/gunicorn --config /srv/servorabd/deploy/gunicorn.conf.py
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=30
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/servorabd/backend/media /srv/servorabd/backend/private_media

[Install]
WantedBy=multi-user.target

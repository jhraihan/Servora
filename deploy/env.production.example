SECRET_KEY=<generate on the server: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())">
DEBUG=False
ALLOWED_HOSTS=shebalocal.example.com
CSRF_TRUSTED_ORIGINS=https://shebalocal.example.com
CORS_ALLOWED_ORIGINS=

DATABASE_URL=postgres://sheba:<app password>@127.0.0.1:5432/shebalocal

EMAIL_HOST=<smtp host>
EMAIL_PORT=587
EMAIL_HOST_USER=<smtp user>
EMAIL_HOST_PASSWORD=<smtp password>
DEFAULT_FROM_EMAIL=ShebaLocal <no-reply@shebalocal.example.com>

TRUSTED_PROXY_COUNT=1

OTP_TTL_SECONDS=300
OTP_MAX_SENDS_PER_HOUR=3
OTP_MAX_VERIFY_ATTEMPTS=5
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14
PLATFORM_COMMISSION_PERCENT=12
TRUST_ALGO_VERSION=v1.0
